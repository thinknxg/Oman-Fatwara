{
  "doctype": "DocType",
  "name": "Oman VAT Return",
  "module": "Oman VAT",
  "engine": "InnoDB",
  "field_order": [
    "company",
    "from_date",
    "to_date",
    "boxes",
    "output_vat",
    "input_vat",
    "net_vat",
    "portal_reference",
    "filed_return",
    "source_snapshot",
    "snapshot_hash",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "from_date",
      "fieldtype": "Date",
      "label": "From Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "to_date",
      "fieldtype": "Date",
      "label": "To Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "boxes",
      "fieldtype": "Table",
      "label": "VAT Return Working Boxes",
      "options": "Oman VAT Box",
      "read_only": 1
    },
    {
      "fieldname": "output_vat",
      "fieldtype": "Currency",
      "label": "Total Output VAT (7a)",
      "read_only": 1,
      "options": "Company:company:default_currency",
      "precision": "3"
    },
    {
      "fieldname": "input_vat",
      "fieldtype": "Currency",
      "label": "Total Input VAT (7b)",
      "read_only": 1,
      "options": "Company:company:default_currency",
      "precision": "3"
    },
    {
      "fieldname": "net_vat",
      "fieldtype": "Currency",
      "label": "Net VAT Payable / (Credit) (7c)",
      "read_only": 1,
      "options": "Company:company:default_currency",
      "precision": "3"
    },
    {
      "fieldname": "portal_reference",
      "fieldtype": "Data",
      "label": "Portal Filing Reference",
      "allow_on_submit": 1
    },
    {
      "fieldname": "filed_return",
      "fieldtype": "Attach",
      "label": "Filed Return Receipt",
      "allow_on_submit": 1
    },
    {
      "fieldname": "source_snapshot",
      "fieldtype": "Long Text",
      "label": "Source Snapshot",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "snapshot_hash",
      "fieldtype": "Data",
      "label": "Snapshot SHA-256",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Oman VAT Return",
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ],
  "istable": 0,
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "format:OMVAT-RETURN-{YYYY}-{#####}"
}
