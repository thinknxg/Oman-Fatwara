{
  "doctype": "DocType",
  "name": "Oman VAT Entry",
  "module": "Oman VAT",
  "engine": "InnoDB",
  "field_order": [
    "company",
    "posting_date",
    "kind",
    "journal_entry",
    "evidence_reference",
    "attachment",
    "import_treatment",
    "taxable_base",
    "vat_amount",
    "recovery_percent",
    "capital_asset",
    "snapshot",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "VAT / Journal Posting Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "kind",
      "fieldtype": "Select",
      "label": "Entry Type",
      "reqd": 1,
      "in_list_view": 1,
      "options": "Customs Paid Import\nPostponed Import\nOutput Adjustment\nInput Adjustment"
    },
    {
      "fieldname": "journal_entry",
      "fieldtype": "Link",
      "label": "Journal Entry",
      "options": "Journal Entry",
      "reqd": 1
    },
    {
      "fieldname": "evidence_reference",
      "fieldtype": "Small Text",
      "label": "Customs / Adjustment Evidence Reference",
      "reqd": 1
    },
    {
      "fieldname": "attachment",
      "fieldtype": "Attach",
      "label": "Supporting Evidence"
    },
    {
      "fieldname": "import_treatment",
      "fieldtype": "Select",
      "label": "Import VAT Treatment",
      "options": "Standard Rated\nZero Rated\nExempt",
      "default": "Standard Rated",
      "reqd": 1
    },
    {
      "fieldname": "taxable_base",
      "fieldtype": "Currency",
      "label": "Customs Taxable Value (OMR)",
      "options": "Company:company:default_currency",
      "precision": "3"
    },
    {
      "fieldname": "vat_amount",
      "fieldtype": "Currency",
      "label": "VAT Amount (signed for adjustments)",
      "reqd": 1,
      "options": "Company:company:default_currency",
      "precision": "3"
    },
    {
      "fieldname": "recovery_percent",
      "fieldtype": "Percent",
      "label": "Recoverable Input VAT %",
      "default": "100",
      "reqd": 1
    },
    {
      "fieldname": "capital_asset",
      "fieldtype": "Check",
      "label": "Capital Asset"
    },
    {
      "fieldname": "snapshot",
      "fieldtype": "Long Text",
      "label": "Calculated Snapshot",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Oman VAT Entry",
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ],
  "istable": 0,
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "format:OMVAT-ENTRY-{YYYY}-{#####}"
}
