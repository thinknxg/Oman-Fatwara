{
  "doctype": "DocType",
  "name": "Oman VAT Settings",
  "module": "Oman VAT",
  "engine": "InnoDB",
  "field_order": [
    "company",
    "enabled",
    "effective_from",
    "input_account",
    "output_account",
    "blocked_account"
  ],
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0"
    },
    {
      "fieldname": "effective_from",
      "fieldtype": "Date",
      "label": "Activation Date",
      "reqd": 1,
      "description": "All submitted invoices from this date need VAT classification. Historical data needs review."
    },
    {
      "fieldname": "input_account",
      "fieldtype": "Link",
      "label": "Input VAT Account",
      "options": "Account",
      "reqd": 1
    },
    {
      "fieldname": "output_account",
      "fieldtype": "Link",
      "label": "Output VAT Account",
      "options": "Account",
      "reqd": 1
    },
    {
      "fieldname": "blocked_account",
      "fieldtype": "Link",
      "label": "Blocked VAT Expense Account",
      "options": "Account",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "field:company",
  "title_field": "company",
  "allow_rename": 0
}
