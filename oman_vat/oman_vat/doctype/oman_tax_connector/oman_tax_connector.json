{
  "doctype": "DocType",
  "name": "Oman Tax Connector",
  "module": "Oman VAT",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0"
    },
    {
      "fieldname": "environment",
      "fieldtype": "Select",
      "label": "Environment",
      "options": "Sandbox\nProduction",
      "default": "Sandbox",
      "reqd": 1
    },
    {
      "fieldname": "return_provider",
      "fieldtype": "Data",
      "label": "VAT Return Provider Adapter",
      "description": "Registered adapter key from an installed integration app. No built-in portal API is assumed."
    },
    {
      "fieldname": "einvoice_provider",
      "fieldtype": "Data",
      "label": "Fawtara Provider Adapter",
      "description": "Registered adapter key for your accredited service provider."
    },
    {
      "fieldname": "endpoint_url",
      "fieldtype": "Data",
      "label": "Approved Provider Endpoint URL"
    },
    {
      "fieldname": "api_secret",
      "fieldtype": "Password",
      "label": "Provider API Secret",
      "permlevel": 1
    },
    {
      "fieldname": "seller_endpoint",
      "fieldtype": "Data",
      "label": "Seller Peppol Endpoint ID"
    },
    {
      "fieldname": "endpoint_scheme",
      "fieldtype": "Data",
      "label": "Seller Endpoint Scheme"
    },
    {
      "fieldname": "auto_file_returns",
      "fieldtype": "Check",
      "label": "Automatically Queue Submitted VAT Returns",
      "default": "0"
    },
    {
      "fieldname": "auto_send_einvoices",
      "fieldtype": "Check",
      "label": "Automatically Queue Submitted Sales Invoices",
      "default": "0"
    }
  ],
  "field_order": [
    "company",
    "enabled",
    "environment",
    "return_provider",
    "einvoice_provider",
    "endpoint_url",
    "api_secret",
    "seller_endpoint",
    "endpoint_scheme",
    "auto_file_returns",
    "auto_send_einvoices"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "System Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "field:company",
  "allow_rename": 0
}
